# Default-deny the build context. Dockerfile only needs package metadata,
# TypeScript config, source files, and the container entrypoint.
*

# Runtime build inputs
!Dockerfile
!docker-entrypoint.sh
!package.json
!package-lock.json
!tsconfig.json
!tsconfig.build.json
!src/
!src/**

# Keep heavyweight, generated, local, and secret-bearing files out even if a
# future broad allow rule is added above.
.git/
.github/
node_modules/
dist/
coverage/
artifacts/
site/
.generated-docs/
.venv-docs/
.npm/
.pnpm-store/
.cloakbrowser/
.cloakbrowser-mcp/
docs/
tests/
scripts/
logs/
*.log
*.tgz
*.tsbuildinfo
.env
.env.*
.DS_Store
Thumbs.db
.idea/
.vscode/
